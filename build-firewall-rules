if [ ! -r "$TEMPLATE" ]; then
    err "Template '$TEMPLATE' not found!"
    exit 1
fi

inf "Processing rules template $TEMPLATE"

[ "$n" ] || {
    inf "Backing up existing rulesets"
    [ -f "$V4_OUT" ] && cp "$V4_OUT" "$V4_OUT".bak
    [ -f "$V6_OUT" ] && cp "$V6_OUT" "$V6_OUT".bak
}

# File-Deskriptoren öffnen: FD 3 -> rules.v4, FD 4 -> rules.v6
exec 3>"$V4_OUT"
exec 4>"$V6_OUT"

# Filter-Header schreiben - passiert jetzt mit TABLE-Statement!
#for fd in 3 4; do
#    cat <<EOF >&$fd
#*filter
#:INPUT DROP [0:0]
#:FORWARD DROP [0:0]
#:OUTPUT ACCEPT [0:0]
#:DOCKER - [0:0]
#:DOCKER-USER - [0:0]
#EOF
#done

# Template sourcen
{ . "$TEMPLATE"; } 3>&3 4>&4

# Footer schreiben
[ "$table" ] && { echo "COMMIT" >&3; echo "COMMIT" >&4; table=; }

# Deskriptoren schließen
exec 3>&-
exec 4>&-

inf "Validating rule syntax with iptables-restore / ip6tables-restore ..."

# Prüfen, ob ipset verfügbar ist und Dummy-Sets für den Test anlegen
if command -v ipset >/dev/null 2>&1; then
    ipset create "$SPAMHAUS_SET_V4" hash:net -exist 2>/dev/null || true
    ipset create "$SPAMHAUS_SET_V6" hash:net family inet6 -exist 2>/dev/null || true
    case "$HOSTNAME" in
        drfasching)
            ipset create "manual-blocklist" hash:net -exist 2>/dev/null || true;;
        schroedingerscat)
            ipset create "geoip_de" hash:net -exist 2>/dev/null || true;;
    esac
fi

if iptables-restore --test < "$V4_OUT" && ip6tables-restore --test < "$V6_OUT"; then
    if [ "$n" ]; then
        inf "[SUCCESS] Syntax test passed! (Dry-run: No files have been changed)."
    else
        inf "[SUCCESS] $V4_OUT and $V6_OUT generated and validated."
        [ "$l" ] && {
            ntc "[LIVE] Activating IPv4 rules $V4_OUT now!"
            iptables-restore <"$V4_OUT" || err "Error activating IPv4 rules!"
            ntc "[LIVE] Activating IPv6 rules $V6_OUT now!"
            ip6tables-restore <"$V6_OUT" || err "Error activating IPv6 rules!"
        }
    fi
else
    err "Syntax error during rule generation!"
    exit 1
fi
