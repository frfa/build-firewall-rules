### Protokollspezifische Regeln
# H2 Protocol-specific DSL functions
# H3 ICMP input DSL functions
# F ICMP type function, for both v4 and v6 rulesets.
# I icmp-type ICMP accept type this rule applies to, e.g. `echo-request`
# I iptables-args Same argument syntax as for iptables(8) command arguments
# EX `ICMP echo-request 'LIMIT 1 5'`
# _Defines a rate-limited rule to allow pings. See below for the `LIMIT` in-rule
# helper function._ <br>
# `ICMP DROP echo-request` <br>
# _Denies ICMP echo requests._
ICMP()  { local tgt=ACCEPT; ischain "$1" && { tgt="$1"; shift; }
          IN4 "$tgt" -p icmp --icmp-type "$@"
          IN6 "$tgt" -p icmpv6 --icmpv6-type "$@"; }
# F ICMP type function, for v4 ruleset only.
# I icmp-type ICMP accept type this rule applies to, e.g. `echo-request`
# I iptables-args Same argument syntax as for iptables(8) command arguments
ICMP4() { local tgt=ACCEPT; ischain "$1" && { tgt="$1"; shift; }
          IN4 "$tgt" -p icmp --icmp-type "$@"; }
# F ICMP type function, for v6 ruleset only.
# I icmp-type ICMP accept type this rule applies to, e.g. `echo-request`
# I iptables-args Same argument syntax as for iptables(8) command arguments
ICMP6() { local tgt=ACCEPT; ischain "$1" && { tgt="$1"; shift; }
          IN6 "$tgt" -p icmpv6 --icmpv6-type "$@"; }
# TCP
# H3 TCP input DSL functions
# F TCP traffic on a certain interface and specific port(s), both v4 and v6.
# I target Optional jump target chain, defaults to `ACCEPT`
# I interface The interface where TCP traffic should be handled
# I port(s) Port specification, single, multiple comma-separated, or port range
# EX `TCP eth0 22`
# _Allow SSH input on the `eth0` interface._ <br>
# `TCP DROP eth1 80,443` <br>
# _Deny HTTP(S) traffic on the `eth1` interface._ <br>
# `TCP enp4s0 0-1023`
# _Allow all well-known ports for TCP on the `enp4s0` interface._
TCP() { local tgt=ACCEPT; ischain "$1" && { tgt="$1"; shift; }
        local IF="$1" PORTS="$2"
        contains "$PORTS" ',' &&\
            IN "$tgt" -i "$IF" -p tcp -m multiport --dports "$PORTS" ||\
                IN "$tgt" -i "$IF" -p tcp --dport "$PORTS"; }
# F TCP traffic on a certain interface and specific port(s), v4 only.
# I target Optional jump target chain, defaults to `ACCEPT`
# I interface The interface where TCP traffic should be handled
# I port(s) Port specification, single, multiple comma-separated, or port range
TCP4() { local tgt=ACCEPT; ischain "$1" && { tgt="$1"; shift; }
         local IF="$1" PORTS="$2"
         contains "$PORTS" ',' &&\
             IN4 "$tgt" -i "$IF" -p tcp -m multiport --dports "$PORTS" ||\
                 IN4 "$tgt" -i "$IF" -p tcp --dport "$PORTS"; }
# F TCP traffic on a certain interface and specific port(s), v6 only.
# I target Optional jump target chain, defaults to `ACCEPT`
# I interface The interface where TCP traffic should be handled
# I port(s) Port specification, single, multiple comma-separated, or port range
TCP6() { local tgt=ACCEPT; ischain "$1" && { tgt="$1"; shift; }
         local IF="$1" PORTS="$2"
         contains "$PORTS" ',' &&\
             IN6 "$tgt" -i "$IF" -p tcp -m multiport --dports "$PORTS" ||\
                 IN6 "$tgt" -i "$IF" -p tcp --dport "$PORTS"; }
# UDP
# H3 UDP input DSL functions
# F UDP traffic on a certain interface and specific port(s), both v4 and v6.
# I target Optional jump target chain, defaults to `ACCEPT`
# I interface The interface where UDP traffic should be handled
# I port(s) Port specification, single, multiple comma-separated, or port range
# EX `UDP eth0 53`
# _Allow DNS input on the `eth0` interface._ <br>
# `UDP DROP eth1 137,138` <br>
# _Deny NETBIOS traffic on the `eth1` interface._ <br>
# `UDP enp4s0 0-1023`
# _Allow all well-known ports for UDP on the `enp4s0` interface._
UDP() { local tgt=ACCEPT; ischain "$1" && { tgt="$1"; shift; }
        local IF="$1" PORTS="$2"
        contains "$PORTS" ',' &&\
            IN "$tgt"-i "$IF" -p udp -m multiport --dports "$PORTS" ||\
                IN "$tgt" -i "$IF" -p udp --dport "$PORTS"; }
# F UDP traffic on a certain interface and specific port(s), v4 only.
# I target Optional jump target chain, defaults to `ACCEPT`
# I interface The interface where UDP traffic should be handled
# I port(s) Port specification, single, multiple comma-separated, or port range
UDP4() { local tgt=ACCEPT; ischain "$1" && { tgt="$1"; shift; }
         local IF="$1" PORTS="$2"
         contains "$PORTS" ',' &&\
             IN4 "$tgt" -i "$IF" -p udp -m multiport --dports "$PORTS" ||\
                 IN4 "$tgt" -i "$IF" -p udp --dport "$PORTS"; }
# F UDP traffic on a certain interface and specific port(s), v6 only.
# I target Optional jump target chain, defaults to `ACCEPT`
# I interface The interface where UDP traffic should be handled
# I port(s) Port specification, single, multiple comma-separated, or port range
UDP6() { local tgt=ACCEPT; ischain "$1" && { tgt="$1"; shift; }
         local IF="$1" PORTS="$2"
         contains "$PORTS" ',' &&\
             IN6 "$tgt"-i "$IF" -p udp -m multiport --dports "$PORTS" ||\
                 IN6 "$tgt" -i "$IF" -p udp --dport "$PORTS"; }

# in-rule helpers (use backtick notation) e.g. IN `ESTABLISHED`
# H2 In-Rule helper functions
# MD These functions are not to be used as DSL rule commands; rather they are
# designed to be used within a rule definition using the backtick \` or shell
# command substitution `$(...)` syntax, as they expand to a list of arguments
# for iptables(8). These helper functions make it easier to specify features
# like ICMP types, conntrack state information, rate limiting, or TCP flags
# within a rule.
# F Inserts ICMP protocol and ICMP type within a rule.
# I icmp-type The icmp-type to include
# EX ``IN4 `ICMPTYPE echo-request` ``
# Inserts the expansion `-p icmp --icmp-type echo-request` within the rule,
# allowing ICMPv4 echo requests on input.
ICMPTYPE() { echo -n "-p icmp --icmp-type $*"; }
# F Inserts ICMPv6 protocol and ICMPv6 type within a rule.
# I icmp-type the icmp-type to include
# EX ``IN6 `ICMP6TYPE echo-request` ``
# Inserts the expansion `-p icmpv6 --icmpv6-type echo-request` within the rule,
# allowing ICMPv6 echo requests on input.
ICMP6TYPE() { echo -n "-p icmpv6 --icmpv6-type $*"; }
# F Inserts conntrack state matching within a rule.
# I ctstate The conntrack states to be included
# EX ``IN `STATE ESTABLISHED,RELATED` ``
# Accepts already established connections connections on input.
STATE() { echo -n "-m conntrack --ctstate $*"; }
# F Inserts conntrack `ESTABLISHED,RELATED` information in the rule.
# This is a shortcut for the `STATE ESTABLISHED,RELATED` example above.
# EX ``IN `ESTABLISHED` `` -- same as above example.
ESTABLISHED() { STATE "ESTABLISHED,RELATED"; }
# F Inserts rate limiting within the rule
# I limit The packets per second limit to include
# I burst The burst packet limit to include
# EX ``ICMP echo-request `LIMIT 1 5` ``
# This allows rate-limited ping requests, with a limit of 1 packet per second,
# and a burst rate of 5 packets per second. This is the default btw, so you may
# use just ``ICMP echo-request `LIMIT` ``, which has the same effect.
LIMIT() { echo -n "-m limit --limit ${1:-1}/s --limit-burst ${2:-5}"; }
# F Insert TCP flag information within the rule
# I check The set of flags to check against
# I flags The flags that must be set for the expression to match
# EX ``TCP eth0 22 `TCPFLAGS SYN,RST SYN` ``
# Allows new SSH connections on input.
TCPFLAGS() { echo -n "-p tcp --tcp-flags ${1:-SYN,RST} ${2:-SYN}"; }
# F Matches a named `ipset` IP set for eitcher source (default) or destination
# address.
# I ipset-name Name of the IP set to match against
# I src-dst Match against source (`src`, default) or destination (`dst`) addresses
MATCHSET() { echo -n "-m set --match-set ${1:-spamhaus_drop} ${2:-src}"; }
# F Target-specific helpers for MSS clamping, or packet marking.
# I tgt Target specification: `TCPMSS`, or `MARK nnn`
# EX `` POSTROUTING "`TARGET TCPMSS`" -o "$EXT_IF" `TCPFLAGS SYN,RST SYN` ``
# Introduces MSS clamping for the `TCPMSS` target for new connections on the
# external interface (using the `TCPFLAGS` in-rule helper). This results in the
# rule `-A POSTROUTING -o eth1 -p tcp --tcp-flags SYN,RST SYN -j TCPMSS
# --clamp-mss-to-pmtu` appended to the `/etc/iptables/rules.v4` file. <br>
# `` R4 PREROUTING "`TARGET MARK 100`" `MATCHSET "$GEOIP_SET" dst` `` <br>
# This marks packets that match against a certain IP set with mark 100 during
# pre-routing.
TARGET() {
    case "$1" in
        TCPMSS) echo -n "$1 --clamp-mss-to-pmtu";;
        MARK)   echo -n "$1 --set-mark ${2:-100}";;
        *)      echo -n "$*";;
    esac
}

# Shortcuts, NAT / Port-Forwarding DSL-Erweiterungen
# H2 Shortcuts for blocklists, NAT and port forwarding
# F Blocks IPv4 source addresses on input and forward that match against a certain IP set.
# I ipset Name of the IP set to match against
# EX `BLOCKLIST4 "spamhaus_drop"`
# Drop packets from IPv4 addresses contained in the Spamhaus DROP list.
BLOCKLIST4() {
    R4 INPUT DROP `MATCHSET "$1" src`
    R4 FORWARD DROP `MATCHSET "$1" src`
}
# F Blocks IPv6 packets on input and forward that match against a certain IP set.
# I ipset Name of the IP set to match against
# EX `BLOCKLIST6 "spamhaus_drop_v6"`
# Drop packets from IPv6 addresses contained in the Spamhaus IPv6 DROP list.
BLOCKLIST6() {
    R6 INPUT DROP `MATCHSET "$1" src`
    R6 FORWARD DROP `MATCHSET "$1" src`
}
# F Establishes masquerading for IPv4 source addresses during post-routing. <br>
# **Note**: This DSL function has to be used within the `TABLE nat` section!
# EX `MASQUERADE -o "$EXT_IF"`
# Establish source address masquerading on outgoing packets on the external
# interface.
MASQUERADE() { R4 POSTROUTING MASQUERADE "$@"; } # assumes TABLE nat!
# F Establishes destination NAT (DNAT) for IPv4 destination addresses during
# pre-routing. <br>
# **Note**: This DSL function has to be used within the `TABLE nat` section!
# EX `DNAT -o "$EXT_IF"` ! -s "$INTRANET"
# Establish destination NAT on outgoing packets, but not for internal Intranet
# addresses.
DNAT()       { R4 PREROUTING DNAT "$@"; } # DNAT ist meist IPv4-spezifisch
#MASQUERADE() { R4 POSTROUTING MASQUERADE -t nat "$@"; }
#DNAT()       { R4 PREROUTING DNAT -t nat "$@"; } # DNAT ist meist IPv4-spezifisch

