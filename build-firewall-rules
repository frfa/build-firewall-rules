#!/bin/sh
# $Id$
program="${0##*/}"

# H1 `build-firewall-rules` - create iptables IPv4 and IPv6 rules from template
# MD This script uses `/etc/iptables/rules.template` as input to generate valid
# `/etc/iptables/rules.v4` for IPv4, and `/etc/iptables/rules.v6` iptables
# filter rule files, that can be loaded via `iptables-restore
# </etc/iptables/rules.v4` and `ip6tables-restore </etc/iptables/rules.v6`
# respectively.
# > NOTE: Install `iptables-persistent` to load those filter-rules automatically
# at startup.

# --- Standard-Optionen ---
TEMPLATE="/etc/iptables/rules.template"

# vars
d= v= q= n=

# funcs
[ -t 2 ] && black='\033[30m' red='\033[31m' green='\033[32m' yellow='\033[33m' blue='\033[34m' magenta='\033[35m' cyan='\033[36m' white='\033[37m' dflt='\033[39m'
#msg() { [ "$q" ] || echo `date +"%Y-%m-%d %T"` $program "$@" >&2; }
#msg() { [ "$q" ] || echo $program "$@" >&2; }
msg() { echo "$@" >&2; } # generic messages are always issued
dbg() { [ "$d" ] && msg "${white}D $*$dflt"; } # debug messages on -d
dbgx() { [ "$d" ] && { echo -n "$white"; "$@"; echo -n "$dflt";} }
ntc() { [ "$q" ] || msg "${green}N $*$dflt"; } # notices always except on -q
inf() { [ "$v" ] && msg "${cyan}I $*$dflt"; } # informationals only on -v
wrn() { [ "$q" ] || msg "${yellow}W $*$dflt"; } # warnings always except on -q
err() { msg "${red}E $*$dflt"; } # errors are issued always
syserr() { msg "${red}E $*: `expl \\\$!=$?`$dflt"; } # system errors as well
ftl() { msg "${red}F $* ($?)$dflt"; exit 1; } # fatals exit
sysftl() { msg "${red}F $*: `expl \\\$!=$?`$dflt"; exit 1; } # system fatals
exe() { [ "$n" ] && msg "$*" || { dbg "$*"; "$@"; }; } # executions except -n
# helpers
expl() { perl -e "print $*"; }
contains() { expr "$1" : ".*[$2]" >/dev/null; }
# predicates forr Chains ^[A-Z], Interfaces ^[a-z] and Options ^-
ischain() { expr "$1" : '^[A-Z]' >/dev/null; }
isif() { expr "$1" : '^[a-z]' >/dev/null; }
isopt() { expr "$1" : '^-' >/dev/null; }

# H2 Usage
# MD build-firewall-rules is called as follows:
# CODE
# build-firewall-rules [OPTIONS] [TEMPLATE_FILE]
# ENDCODE
# MD If the rules `TEMPLATE_FILE` is not provided, the default rules template
# file `/etc/iptables/rules.template` is assumed.
# MD The following options may be used on invocation:
usage() {
    # OPTIONS
    cat <<EOF
Usage: $program [OPTIONS] [TEMPLATE_FILE]

Generates synchronized /etc/iptables/rules.v4 and /etc/iptables/rules.v6
from a single rules template file.

Options:
  -v, --verbose  Print verbose log information to standard error
  -n, --noexec   Generates and validates rules, but does not overwrite any files
  -q, --quiet    Suppresses normal log output, only errors will be displayed
  -h, --help     Shows this help text
  -l, --live     Immediately activates generated rules after successful validation

Default TEMPLATE_FILE: $TEMPLATE
EOF
    # OPTEND
    exit 0
}
# > NOTE: Using the `-n, --noexec` and the `-l, --live` options at the same time
# will reload the existing firewall rules `/etc/iptables/rules.v4` and
# `/etc/iptables/rules.v6`, as only temporary files will be generated and
# validated. Recommended usage is therefore to test new iptables rules with
# `build-firewall-rules -n`, followed by a `build-firewall-rules -l` after
# successful validation.

# Use sudo unless root
[ "$(id -u)" != 0 ] && {
    wrn "root privileges required, re-starting with sudo ..."
    exec sudo "$0" "$@"
}

# Setze HOSTNAME, wenn nicht gesetzt
[ "$HOSTNAME" ] || HOSTNAME=`hostname`

# --- POSIX Parameter Parsing ---
while :; do
    case "$1" in
	# generic options
        -d|--debug) d=-d v=-v q=;;
        -dd|--moredebug) d=-d v=-v q=; set -xv;;
        -v|--verbose) v=-v q=;;
        -q|--quiet) q=-q v=;;
        -n|--noexec) n=-n;;
	-h|--help) usage;;
        # specific options go here
        -l|--live) l="$1";;
	-*) wrn "Unknown option $1 ignored";;
	*) break;;
    esac
    shift
done
generic_opts="$d $v $q"
#[ $# -lt 1 ] && ftl 'No arguments provided'

# optional first arg: template file
[ "$1" ] && TEMPLATE="$1"
TARGET_DIR=$(dirname "$TEMPLATE")

if [ "$n" ]; then
    inf "DRY-RUN mode - temporary rule files used"
    V4_OUT=$(mktemp)
    V6_OUT=$(mktemp)
    trap 'rm -f "$V4_OUT" "$V6_OUT"' EXIT
else
    V4_OUT="$TARGET_DIR/rules.v4"
    V6_OUT="$TARGET_DIR/rules.v6"
fi

# =========================================================
# DSL API-Kapselung (Schreibt in File-Deskriptoren FD 3 & 4)
# =========================================================

# H1 Syntax of the rules template file `/etc/iptables/rules.template`
#
# MD The rules template file is processed like any other shell script, so
# employs POSIX-shell syntax. However, lots of useful shell functions for
# firewall rule generation are predefined and form a kind of DSL
# (Domain-Specific Language) to define a customized set of IPv4 and IPv6 rules.
# MD Most of the DSL commands may be used with a "4" or "6" suffix to indicate
# the corresponding rules should be generated for the IPv4 rules file
# `/etc/iptables/rules.v4` or the IPv6 rules file `/etc/iptables/rules.v5`
# respectively only.

# H2 Comments
# MD For example, comments in the `rules.template` file may be transliterated to
# either both the `rules.v4` and `rules.v6` files only, when using the `CC` or
# `C` DSL commands, while `C4` or `CC4` will transliterate the comment to the
# `rules.v4` file only, and `C6` or `CC6` to the `rules.v6` file only.
# MD Examples:
# CODE
# C 'This comment will appear both in the rules.v4 and rules.v6 file'
# C4 'This comment will appear in the rules.v4 file only'
# C6 'This comment will appear in the rules.v6 file only'
# ENDCODE

# MD The difference between the 'C' and 'CC' variants is, that 'CC' will emit an
#additional newline "`\n`" before the comment line, which enables structurizing
#the generated rulesets and make if more human-readable.

# > NOTE: Including a pure shell comment line starting with a hash sign "`#`" in
#the rule template is possible, but will **not** transliterate the comment to
#either ruleset!

### Kommentare/Remarks (schreibt "# ..." in v4 und v6)
# F A comment, transliterated both to v4 and v6 rulesets.
# I String The comment to transliterate.
C() {
    dbg "Comment: $*"
    echo "# $*" >&3
    echo "# $*" >&4
}
# F A comment, transliterated onyl to the v4 ruleset.
# I String The comment to transliterate.
C4() { dbg "v4-Comment: $*"; echo "# $*" >&3; }
# F A comment, transliterated onyl to the v6 ruleset.
# I String The comment to transliterate.
C6() { dbg "v6-Comment: $*"; echo "# $*" >&4; }
# F A comment preceded by a newline, transliterated to both v4 and v6 rulesets.
# I String The comment to transliterate.
CC() { echo >&3; echo >&4; C "$@"; }
# F A comment preceded by a newline, transliterated to only the v4 ruleset.
# I String The comment to transliterate.
CC4() { echo >&3; C4 "$@"; }
# F A comment preceded by a newline, transliterated to only the v6 ruleset.
# I String The comment to transliterate.
CC6() { echo >&4; C6 "$@"; }

# Tabellen-Wechsel (Schließt vorherige Tabelle ab und öffnet neue)
# H2 Table management
# MD A new table is started with the `TABLE` command, followed by the table name
# (e.v. `filter`, `mangle`, `nat`, etc.), and followed by pairs of chain name
# and default policy for the chain for the chains in the table.
table=
# F Starts a new table. If the table name is `filter` not followed by any
# chain-policy pairs, the default setup will be `INPUT DROP FORWRD DROP OUTPUT
# ACCEPT`, meaning the default policy for the `INPUT` and `FORWARD` chains will
# be set to `DROP`, and the default policy for the `OUTPUT`chain will be
# `ACCEPT` -- a typical default firewall setup. A preceding `TABLE` will
# automatically be `COMMIT`ted, if applicable.
# I name The table name
# I chain The chain name
# I policy The default policy for the chain
# - ... More chain-policy pairs
# EX `TABLE filter`, same as
# `TABLE filter INPUT DROP FORWARD DROP OUTPUT ACCEPT` <br>
# You can also add other chain-policy pairs as necessary, e.g `DOCKER-USER -`,
# indicating a Docker user chain without a default policy, as this chain is
# managed by the Docker daemon.
TABLE() { # table-name [CHAIN POLICY ...]
    [ "$table" ] && { rule "COMMIT"; table=; }
    table="$1"; shift
    C "Changing table: $table"
    rule "*$table"
    # setup default filter chains for a firewall if none specified
    [ "$table" = "filter" -a -z "$*" ] &&\
        set -- INPUT DROP FORWARD DROP OUTPUT ACCEPT
    while [ "$1" ]; do
        chain="$1" policy="$2"; shift 2
        rule ":$chain $policy [0:0]"
    done
}

### Generische Regeln für IPv4 + IPv6 mit Debug-Ausgabe
# H2 Generic DSL commands
# MD Generic commands allow to construct any arbitrary iptables rule, as they
# pass their arguments as-is to the v4 and/or v6 result rulesets. This means,
# you have to use the exact same syntax for the arguments as for the iptables(8)
# command. You'll hardly use them, as the whole purpose of the DSL is to make
# life easier than hardcoding iptables rules.
#
# F Generic rule for both v4 and v6 rulesets.
# I iptables-args Same argument syntax as for iptables(8) command arguments
# EX `rule -A INPUT -i eth0 -j ACCEPT`
rule() { dbg "v4+v6 $*"; echo "$@" >&3; echo "$@" >&4; }
# F Generic rule for v4 ruleset only.
# I iptables-args Same argument syntax as for iptables(8) command arguments
rule4() { dbg "v4 $*"; echo "$@" >&3; }
# F Generic rule for v6 ruleset only.
# I iptables-args Same argument syntax as for iptables(8) command arguments
rule6() { dbg "v6 $*"; echo "$@" >&4; }
chain() { rule -A "$@"; }
chain4() { rule4 -A "$@"; }
chain6() { rule6 -A "$@"; }
# 2 fixe Argumente - append-chain, target-chain
# F Generic rule with fixed chain and optional jump target arguments, v4+v6. The
# jump target argument may be omitted, and defaults to `ACCEPT`. This will
# probbaly be the most-used DSL command in a `rules.template`, as for a typical
# firewall ruleset the default policy is `DROP`, and the rules then typically
# `ACCEPT` some specific traffic.
# I chain The chain this rule is appended to (`-A chain`)
# I target The jump target for this rule (`-j target`)
# I iptables-args Same argument syntax as for iptables(8) command arguments
# EX `R INPUT ACCEPT -i lo`
# same as: `R INPUT -i lo`<br>
# both translate to `-A INPUT -i lo -j ACCEPT` in the rulesets.
R() { chn="$1" tgt=ACCEPT; shift; ischain "$1" && { tgt="$1"; shift; }
      rule "${chn:+-A $chn}" "$@" "${tgt:+-j $tgt}"; }
# F Generic rule with fixed chain and jump target arguments, v4 only.
# I chain The chain this rule is appended to (`-A chain`)
# I target The jump target for this rule (`-j target`)
# I iptables-args Same argument syntax as for iptables(8) command arguments
R4() { chn="$1" tgt=ACCEPT; shift; ischain "$1" && { tgt="$1"; shift; }
       rule4 "${chn:+-A $chn}" "$@" "${tgt:+-j $tgt}"; }
# F Generic rule with fixed chain and jump target arguments, v6 only.
# I chain The chain this rule is appended to (`-A chain`)
# I target The jump target for this rule (`-j target`)
# I iptables-args Same argument syntax as for iptables(8) command arguments
R6() { chn="$1" tgt=ACCEPT; shift; ischain "$1" && { tgt="$1"; shift; }
       rule6 "${chn:+-A $chn}" "$@" "${tgt:+-j $tgt}"; }

### Spezifische DSL
### Jump-Target Shortcuts; ein mandatory append chain Argument
# H2 Target-focused DSL functions
# F Accept rule, for both v4 and v6 rulesets.
